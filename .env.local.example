# ローカル開発用環境変数
# このファイルをコピーして .env.local を作成してください
# cp .env.local.example .env.local
PORT=8080

# LINE Developers コンソールで発行される値（実際の値はコミットしないこと）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 複数人の流れを line-bot-playground（https://github.com/fezzlk/line-bot-playground）で
# 確かめるときだけ設定する。LINE API の送り先を playground のモックに向ける。
# このとき LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN は、playground の
# bots.local.yaml の channelSecret / mockAccessToken と同じ値にする。
# LINE_API_DATA_BASE_URL を省略すると LINE_API_BASE_URL と同じ値を使う。
# LINE_API_BASE_URL=http://host.docker.internal:8787

# Firestoreエミュレータは使わない方針（重いため）。実際のFirestoreに接続して
# ローカル検証したい場合は、実GCPプロジェクトの認証情報を用意して指定する。
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=qk-jenga-line-bot
