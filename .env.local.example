# ローカル開発用環境変数
# このファイルをコピーして .env.local を作成してください
# cp .env.local.example .env.local
PORT=8080

# LINE Developers コンソールで発行される値（実際の値はコミットしないこと）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# docker-compose利用時はFirestoreエミュレータに接続する（docker-compose.ymlで自動設定済み）。
# ローカルでdocker-composeを使わず直接 npm run dev する場合はここで指定する。
# FIRESTORE_EMULATOR_HOST=localhost:8085
# GOOGLE_CLOUD_PROJECT=qk-jenga-line-bot-local
